{
  "name": "deskhub-tickets",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-db": "node scripts/sync-db.mjs",
    "prebuild": "npm run sync-db",
    "dev": "concurrently -k \"node server.mjs\" \"vite\"",
    "api": "node server.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "preview:full": "npm run build && concurrently -k \"node server.mjs\" \"vite preview\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.6",
    "concurrently": "^9.1.2",
    "happy-dom": "^17.6.3",
    "jsdom": "^26.1.0",
    "vite": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  }
}
